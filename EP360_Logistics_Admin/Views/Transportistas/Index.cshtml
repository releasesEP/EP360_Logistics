@model EP360_Logistics_Admin.Models.Paginado<EP360_Logistics_Admin.Models.TransportistaModel>
@{
    ViewBag.Title = "Transportistas";
    var enc = (EncabezadoListado)ViewBag.Encabezado;
    string actividad = ViewBag.Actividad;
    string volver = Request.RawUrl;
}

<div class="encabezado">
    <div class="encabezado-titulo">
        <a href="@Url.Action("Index", "Home")" class="btn-atras" title="Volver al inicio" aria-label="Volver al inicio"><i class="fas fa-arrow-left"></i></a>
        <div>
            <h3><i class="fas fa-truck-fast"></i>Transportistas</h3>
            <p>Líneas transportistas con sus tractores, sus choferes y las cajas que mueven.</p>
        </div>
    </div>
    <div class="encabezado-acciones">
        <a class="btn-corporativo" href="@Url.Action("Crear")"><i class="fas fa-plus"></i> Nuevo transportista</a>
    </div>
</div>


<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><a class="kpi-tile" href="@Url.Action("Index")"><div class="kpi-tile-icono" style="--kpi-color:#0b1b3d;"><i class="fas fa-truck-fast"></i></div><div class="kpi-tile-etiqueta">Transportistas activos</div><div class="kpi-tile-valor">@(((int)ViewBag.TotalActivos).ToString("N0"))</div></a></div>
    <div class="col-6 col-lg-3"><a class="kpi-tile" href="@Url.Action("Index", new { actividad = "conchoferes" })"><div class="kpi-tile-icono" style="--kpi-color:#16a34a;"><i class="fas fa-user-check"></i></div><div class="kpi-tile-etiqueta">Con choferes activos</div><div class="kpi-tile-valor">@(((int)ViewBag.ConChoferes).ToString("N0"))</div><span class="kpi-tile-detalle">Líneas con al menos un chofer</span></a></div>
    <div class="col-6 col-lg-3"><a class="kpi-tile" href="@Url.Action("Index", "Tractores")"><div class="kpi-tile-icono" style="--kpi-color:#475569;"><i class="fas fa-truck"></i></div><div class="kpi-tile-etiqueta">Tractores</div><div class="kpi-tile-valor">@(((int)ViewBag.TotalTractores).ToString("N0"))</div><span class="kpi-tile-detalle">Activos en todas las líneas</span></a></div>
    <div class="col-6 col-lg-3"><a class="kpi-tile" href="@Url.Action("Index", "Choferes")"><div class="kpi-tile-icono" style="--kpi-color:#d97706;"><i class="fas fa-id-card"></i></div><div class="kpi-tile-etiqueta">Ligas con choferes</div><div class="kpi-tile-valor">@(((int)ViewBag.TotalChoferes).ToString("N0"))</div><span class="kpi-tile-detalle">Un chofer puede contar en varias líneas</span></a></div>
</div>

<div class="listado-filtros">
    @Html.Partial("_PestanasListado", enc)
    <form method="get" action="@Url.Action("Index")" class="listado-controles filtros-auto">
        <input type="hidden" name="estado" value="@enc.PestanaActiva" />
        <input type="hidden" name="orden" value="@Request.QueryString["orden"]" />
        <input type="hidden" name="tam" value="@Model.TamPagina" />
        <div class="listado-buscar">
            <i class="fas fa-magnifying-glass"></i>
            <input type="search" name="buscar" value="@ViewBag.Buscar" autocomplete="off" placeholder="Buscar por nombre, razón social, RFC o folio..." @(string.IsNullOrEmpty((string)ViewBag.Buscar) ? "" : "autofocus") />
        </div>
        <select name="actividad" class="form-select form-select-sm" aria-label="Actividad">
            <option value="">Cualquier actividad</option>
            @foreach (var a in EP360_Logistics_Admin.Controllers.TransportistasController.Actividades)
            {
                <option value="@a.Key" @(actividad == a.Key ? "selected" : "")>@a.Value</option>
            }
        </select>
    </form>
    @Html.Partial("_ChipsListado", enc)
</div>

@if (Model.Total == 0)
{
    <div class="tarjeta-tabla-ep">
        <div class="vacio-ep">
            <div class="vacio-icono"><i class="fas fa-truck-fast"></i></div>
            <h6>No hay transportistas con esos filtros</h6>
            <p>Prueba con otra búsqueda o quita algún filtro.</p>
        </div>
    </div>
}
else
{
    <div class="tarjeta-tabla-ep">
        <div class="table-responsive" style="overflow: visible;">
            <table class="tabla-ep">
                <thead>
                    <tr>
                        @Html.ColumnaOrden("Transportista", "nombre")
                        @Html.ColumnaOrden("Choferes", "choferes", "num")
                        @Html.ColumnaOrden("Tractores", "tractores", "num")
                        @Html.ColumnaOrden("Cajas", "cajas", "num")
                        <th>Cuenta del directorio</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Items)
                    {
                        <tr class="@(t.Activo ? "" : "inactiva")">
                            <td>
                                <div class="celda-principal">
                                    <span class="avatar-ep cuadrado @(t.Activo ? "av-ambar" : "av-gris")">@TextoUtil.Iniciales(t.Nombre)</span>
                                    <div style="min-width:0;">
                                        <a class="nombre" href="@Url.Action("Detalle", new { id = t.IdTransportista })">@t.Nombre</a>
                                        <span class="sub">@(t.RazonSocial ?? t.Folio)</span>
                                    </div>
                                </div>
                            </td>
                            <td class="num">@if (t.TotalChoferes > 0) { <a href="@Url.Action("Index", "Choferes", new { idTransportista = t.IdTransportista })" class="fw-bold">@t.TotalChoferes</a> } else { <span class="texto-tenue">0</span> }</td>
                            <td class="num">@if (t.TotalTractores > 0) { <a href="@Url.Action("Index", "Tractores", new { idTransportista = t.IdTransportista })" class="fw-bold">@t.TotalTractores</a> } else { <span class="texto-tenue">0</span> }</td>
                            <td class="num">@if (t.TotalCajas > 0) { <a href="@Url.Action("Index", "Cajas", new { idTransportista = t.IdTransportista })" class="fw-bold">@t.TotalCajas</a> } else { <span class="texto-tenue">0</span> }</td>
                            <td>
                                @if (t.IdCuenta.HasValue)
                                {
                                    <a href="@Url.Action("Detalle", "Cuentas", new { id = t.IdCuenta.Value })"><i class="fas fa-building texto-tenue me-1"></i>@t.Cuenta</a>
                                }
                                else
                                {
                                    <span class="texto-tenue">—</span>
                                }
                            </td>
                            <td>
                                @if (t.Activo)
                                {
                                    <span class="pastilla pastilla-verde"><i class="fas fa-circle"></i>Activo</span>
                                }
                                else
                                {
                                    <span class="pastilla pastilla-gris"><i class="fas fa-circle-pause"></i>Inactivo</span>
                                }
                            </td>
                            <td class="celda-acciones">
                                <div class="dropdown">
                                    <button type="button" class="btn-icono" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Acciones"><i class="fas fa-ellipsis-vertical"></i></button>
                                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-ep compacto">
                                        <a class="dropdown-item" href="@Url.Action("Detalle", new { id = t.IdTransportista })"><i class="fas fa-eye"></i> Ver ficha</a>
                                        <a class="dropdown-item" href="@Url.Action("Editar", new { id = t.IdTransportista })"><i class="fas fa-pen"></i> Editar</a>
                                        @if (t.Activo)
                                        {
                                            <a class="dropdown-item" href="@Url.Action("Crear", "Tractores", new { idTransportista = t.IdTransportista })"><i class="fas fa-truck"></i> Agregar tractor</a>
                                            <a class="dropdown-item" href="@Url.Action("Crear", "Choferes", new { idTransportista = t.IdTransportista })"><i class="fas fa-id-card"></i> Agregar chofer</a>
                                        }
                                        <div class="dropdown-divider"></div>
                                        @using (Html.BeginForm(t.Activo ? "Desactivar" : "Reactivar", "Transportistas", new { id = t.IdTransportista }, FormMethod.Post, new
                                        {
                                            data_confirmar = t.Activo ? "¿Desactivar " + t.Nombre + "?" : "¿Reactivar " + t.Nombre + "?",
                                            data_confirmar_detalle = t.Activo ? "Se darán de baja sus tractores y cajas propias, y se cerrarán sus ligas con choferes (los choferes siguen activos)." : "Sus tractores, cajas y choferes se reactivan uno por uno.",
                                            data_confirmar_tipo = t.Activo ? "peligro" : "normal",
                                            data_confirmar_boton = t.Activo ? "Sí, desactivar" : "Sí, reactivar"
                                        }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@volver" />
                                            <button type="submit" class="dropdown-item @(t.Activo ? "texto-peligro" : "")">
                                                <i class="fas @(t.Activo ? "fa-ban" : "fa-rotate-left")"></i> @(t.Activo ? "Desactivar" : "Reactivar")
                                            </button>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@Html.Partial("_Paginacion", (IPaginado)Model)
