@model EP360_Logistics_Admin.Models.GrupoCuentaModel
@{
    ViewBag.Title = Model.Nombre;
    var cuentas = (List<CuentaModel>)ViewBag.Cuentas;
    var cajas = (List<CajaModel>)ViewBag.Cajas;
    var sinGrupo = (IEnumerable<SelectListItem>)ViewBag.CuentasSinGrupo;
    int contactos = ViewBag.Contactos;
    int cuentasActivas = cuentas.Count(c => c.Activo);
    string volver = Request.RawUrl;
}

<div class="encabezado">
    <div class="encabezado-titulo">
        <a href="@Url.Action("Index")" class="btn-atras" title="Volver a Grupos" aria-label="Volver a Grupos"><i class="fas fa-arrow-left"></i></a>
        <div>
            <h3><i class="fas fa-layer-group"></i>Grupo de cuentas</h3>
            <p>Las cuentas de este cliente y las cajas que tiene.</p>
        </div>
    </div>
</div>

<div class="perfil-cabecera">
    <span class="avatar-ep grande @(Model.Activo ? "" : "av-gris")">@TextoUtil.Iniciales(Model.Nombre)</span>
    <div class="perfil-info">
        <h3>
            @Model.Nombre
            @if (Model.Activo)
            {
                <span class="pastilla pastilla-verde"><i class="fas fa-circle"></i>Activo</span>
            }
            else
            {
                <span class="pastilla pastilla-gris"><i class="fas fa-circle-pause"></i>Inactivo</span>
            }
        </h3>
        <div class="perfil-meta">
            <span><i class="fas fa-hashtag"></i>@Model.Folio</span>
            <span><i class="fas fa-building"></i>@cuentasActivas @(cuentasActivas == 1 ? "cuenta activa" : "cuentas activas")</span>
            <span><i class="fas fa-trailer"></i>@cajas.Count @(cajas.Count == 1 ? "caja" : "cajas")</span>
        </div>
    </div>
    <div class="perfil-acciones">
        <a data-modal class="btn-suave" href="@Url.Action("Editar", new { id = Model.IdGrupoCuenta })"><i class="fas fa-pen"></i> Renombrar</a>
        @using (Html.BeginForm(Model.Activo ? "Desactivar" : "Reactivar", "Grupos", new { id = Model.IdGrupoCuenta }, FormMethod.Post, new
        {
            data_confirmar = Model.Activo ? "¿Desactivar el grupo " + Model.Nombre + "?" : "¿Reactivar el grupo " + Model.Nombre + "?",
            data_confirmar_detalle = Model.Activo ? "Sus cuentas quedan sin grupo y las cajas ligadas al grupo se dan de baja. Puedes reactivarlo después." : "Después tendrás que volver a agregarle sus cuentas.",
            data_confirmar_tipo = Model.Activo ? "peligro" : "normal",
            data_confirmar_boton = Model.Activo ? "Sí, desactivar" : "Sí, reactivar"
        }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@volver" />
            <button type="submit" class="@(Model.Activo ? "btn-peligro-suave" : "btn-suave btn-exito-suave")"><i class="fas @(Model.Activo ? "fa-ban" : "fa-rotate-left")"></i> @(Model.Activo ? "Desactivar" : "Reactivar")</button>
        }
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="kpi-tile"><div class="kpi-tile-icono" style="--kpi-color:#0b1b3d;"><i class="fas fa-building"></i></div><div class="kpi-tile-etiqueta">Cuentas</div><div class="kpi-tile-valor">@cuentasActivas</div>@if (cuentas.Count > cuentasActivas) { <span class="kpi-tile-detalle">+@(cuentas.Count - cuentasActivas) inactivas</span> }</div></div>
    <div class="col-6 col-lg-3"><div class="kpi-tile"><div class="kpi-tile-icono" style="--kpi-color:#1d4ed8;"><i class="fas fa-trailer"></i></div><div class="kpi-tile-etiqueta">Cajas</div><div class="kpi-tile-valor">@cajas.Count</div><span class="kpi-tile-detalle">@cajas.Count(k => k.IdGrupoCuenta == Model.IdGrupoCuenta) del grupo · @cajas.Count(k => k.IdGrupoCuenta != Model.IdGrupoCuenta) de sus cuentas</span></div></div>
    <div class="col-6 col-lg-3"><div class="kpi-tile"><div class="kpi-tile-icono" style="--kpi-color:#d97706;"><i class="fas fa-truck-fast"></i></div><div class="kpi-tile-etiqueta">Transportistas</div><div class="kpi-tile-valor">@cajas.Where(k => k.IdTransportista.HasValue).Select(k => k.IdTransportista).Distinct().Count()</div><span class="kpi-tile-detalle">mueven sus cajas</span></div></div>
    <div class="col-6 col-lg-3"><div class="kpi-tile"><div class="kpi-tile-icono" style="--kpi-color:#1d6fd1;"><i class="fas fa-address-book"></i></div><div class="kpi-tile-etiqueta">Contactos</div><div class="kpi-tile-valor">@contactos</div><span class="kpi-tile-detalle">en sus cuentas activas</span></div></div>
</div>

<ul class="nav pestanas-ep" role="tablist">
    <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#cuentas" type="button" role="tab"><i class="fas fa-building"></i> Cuentas del grupo <span class="contador">@cuentas.Count</span></button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#cajas" type="button" role="tab"><i class="fas fa-trailer"></i> Cajas <span class="contador">@cajas.Count</span></button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="cuentas" role="tabpanel">
        <div class="tarjeta-ep">
            <div class="tarjeta-ep-encabezado">
                <h6><i class="fas fa-building"></i> Cuentas del grupo <span class="contador">@cuentas.Count</span></h6>
                <p>Quien es contacto de cualquiera de estas cuentas ve todas las del grupo.</p>
            </div>
            @if (cuentas.Count == 0)
            {
                <div class="vacio-ep">
                    <div class="vacio-icono"><i class="fas fa-building-circle-xmark"></i></div>
                    <h6>El grupo no tiene cuentas</h6>
                    <p>Agrégale las cuentas de este cliente con el formulario de abajo.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="tabla-ep">
                        <thead><tr><th>Cuenta</th><th>Folio</th><th>Ciudad</th><th>Sucursal</th><th>Estado</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in cuentas)
                            {
                                <tr class="@(c.Activo ? "" : "inactiva")">
                                    <td>
                                        <div class="celda-principal">
                                            <span class="avatar-ep cuadrado @(c.Activo ? "" : "av-gris")">@TextoUtil.Iniciales(c.NombreComercial)</span>
                                            <div style="min-width:0;">
                                                <a class="nombre" href="@Url.Action("Detalle", "Cuentas", new { id = c.IdCuenta })">@c.NombreComercial</a>
                                                <span class="sub">@(c.RazonSocial ?? "Sin razón social")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="small texto-secundario">@c.Folio</td>
                                    <td>@(c.Ciudad ?? "—")</td>
                                    <td>@(c.Sucursal ?? "—")</td>
                                    <td>
                                        @if (c.Activo)
                                        {
                                            <span class="pastilla pastilla-verde"><i class="fas fa-circle"></i>Activa</span>
                                        }
                                        else
                                        {
                                            <span class="pastilla pastilla-gris"><i class="fas fa-circle-pause"></i>Inactiva</span>
                                        }
                                    </td>
                                    <td class="celda-acciones">
                                        @using (Html.BeginForm("QuitarCuenta", "Grupos", FormMethod.Post, new
                                        {
                                            data_confirmar = "¿Quitar " + c.NombreComercial + " del grupo?",
                                            data_confirmar_detalle = "La cuenta queda sin grupo. Sus contactos dejan de ver las demás cuentas del grupo.",
                                            data_confirmar_boton = "Sí, quitar"
                                        }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idGrupoCuenta" value="@Model.IdGrupoCuenta" />
                                            <input type="hidden" name="idCuenta" value="@c.IdCuenta" />
                                            <button type="submit" class="btn-peligro-suave btn-sm-ep"><i class="fas fa-link-slash"></i> Quitar del grupo</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.Activo)
            {
                <div class="tarjeta-ep-pie">
                    @using (Html.BeginForm("AgregarCuenta", "Grupos", FormMethod.Post, new { @class = "row g-2 align-items-end" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idGrupoCuenta" value="@Model.IdGrupoCuenta" />
                        <div class="col-md-8">
                            <label class="form-label small fw-bold texto-secundario mb-1">Agregar una cuenta sin grupo</label>
                            @Html.DropDownList("idCuenta", sinGrupo, "Elige una cuenta…", new { @class = "form-select" })
                        </div>
                        <div class="col-md-4 d-grid"><button type="submit" class="btn-corporativo"><i class="fas fa-plus"></i> Agregar al grupo</button></div>
                    }
                    <p class="ayuda-campo mt-2 mb-0">Solo aparecen cuentas activas que no están en ningún grupo. ¿No existe? <a data-modal="lg" href="@Url.Action("Crear", "Cuentas", new { idGrupoCuenta = Model.IdGrupoCuenta })">Crea la cuenta</a> directo en este grupo.</p>
                </div>
            }
        </div>
    </div>

    <div class="tab-pane fade" id="cajas" role="tabpanel">
        <div class="tarjeta-ep">
            <div class="tarjeta-ep-encabezado">
                <h6><i class="fas fa-trailer"></i> Cajas del cliente <span class="contador">@cajas.Count</span></h6>
                <p>Cajas activas ligadas al grupo y a cada una de sus cuentas.</p>
            </div>
            @if (cajas.Count == 0)
            {
                <div class="vacio-ep">
                    <div class="vacio-icono"><i class="fas fa-trailer"></i></div>
                    <h6>Sin cajas</h6>
                    <p>Este cliente no tiene cajas registradas.</p>
                </div>
            }
            else
            {
                <div class="px-3 pt-3">
                    <div class="listado-buscar" style="max-width:360px;"><i class="fas fa-magnifying-glass"></i><input type="search" placeholder="Buscar caja, placa o transportista..." data-filtrar-tabla="#tablaCajasGrupo" data-filtrar-vacio="#cajasGrupoVacio" /></div>
                </div>
                <div class="table-responsive">
                    <table class="tabla-ep" id="tablaCajasGrupo">
                        <thead><tr><th>Caja</th><th>Ligada a</th><th>Transportista habitual</th><th>Placa / VIN</th><th>Datos</th></tr></thead>
                        <tbody>
                            @foreach (var k in cajas)
                            {
                                <tr data-fila>
                                    <td>
                                        <div class="celda-principal">
                                            <span class="avatar-ep cuadrado av-azul"><i class="fas fa-trailer"></i></span>
                                            <a class="nombre" href="@Url.Action("Detalle", "Cajas", new { id = k.IdCaja })">@k.NumeroCaja</a>
                                        </div>
                                    </td>
                                    <td>
                                        @if (k.IdGrupoCuenta == Model.IdGrupoCuenta)
                                        {
                                            <span class="pastilla pastilla-navy"><i class="fas fa-layer-group"></i>Grupo</span>
                                        }
                                        else
                                        {
                                            <a class="pastilla pastilla-azul" href="@Url.Action("Detalle", "Cuentas", new { id = k.IdCuenta })"><i class="fas fa-building"></i>@k.Cuenta</a>
                                        }
                                    </td>
                                    <td>
                                        @if (k.IdTransportista.HasValue)
                                        {
                                            <a href="@Url.Action("Detalle", "Transportistas", new { id = k.IdTransportista })">@k.Transportista</a>
                                        }
                                        else
                                        {
                                            <span class="texto-tenue">—</span>
                                        }
                                    </td>
                                    <td class="small">@(k.Placa ?? "—")@(k.Vin != null ? " · " + k.Vin : "")</td>
                                    <td class="small texto-secundario">@string.Join(" · ", new[] { k.Marca, k.Anio.HasValue ? k.Anio.Value.ToString() : null, k.Pies.HasValue ? k.Pies.Value + " ft" : null }.Where(x => x != null))</td>
                                </tr>
                            }
                            <tr id="cajasGrupoVacio" style="display:none;"><td colspan="5" class="text-center texto-tenue py-4">Ninguna caja coincide con la búsqueda.</td></tr>
                        </tbody>
                    </table>
                </div>
            }
            <div class="tarjeta-ep-pie d-flex flex-wrap gap-2">
                <a data-modal="lg" class="btn-suave btn-sm-ep" href="@Url.Action("Crear", "Cajas")"><i class="fas fa-plus"></i> Nueva caja</a>
                <a class="btn-suave btn-sm-ep" href="@Url.Action("Index", "Cajas", new { idGrupoCuenta = Model.IdGrupoCuenta })"><i class="fas fa-list"></i> Ver en el listado de cajas</a>
            </div>
        </div>
    </div>
</div>
