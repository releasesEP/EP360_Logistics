@model EP360_Logistics_Admin.Models.GrupoCuentaModel
@{ bool esNuevo = Model.IdGrupoCuenta == 0; }
<div class="modal-content modal-ep">
    @using (Html.BeginForm(esNuevo ? "Crear" : "Editar", "Grupos", FormMethod.Post, new { data_form_modal = "" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IdGrupoCuenta)
        <div class="modal-header">
            <div class="modal-title">
                <span class="modal-ep-icono"><i class="fas fa-layer-group"></i></span>
                <span>@(esNuevo ? "Nuevo grupo de cuentas" : "Renombrar grupo")<small>@(esNuevo ? "Después de guardarlo le agregas sus cuentas." : "Folio " + Model.Folio)</small></span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
            @if (ViewBag.ErrorModal != null)
            {
                <div class="aviso-ep aviso-error mb-3"><i class="fas fa-circle-exclamation"></i><div>@ViewBag.ErrorModal</div></div>
            }
            @Html.ValidationSummary(true)
            @Html.LabelFor(m => m.Nombre)
            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", autofocus = "autofocus", placeholder = "Ej. INVENTEC" })
            @Html.ValidationMessageFor(m => m.Nombre, null, new { @class = "error-campo" })
            <span class="ayuda-campo d-block mt-1">Normalmente el nombre del cliente. No se puede repetir entre grupos activos.</span>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-suave" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn-corporativo"><i class="fas fa-floppy-disk"></i> @(esNuevo ? "Crear grupo" : "Guardar")</button>
        </div>
    }
</div>
