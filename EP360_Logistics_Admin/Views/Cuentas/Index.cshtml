@model System.Collections.Generic.List<EP360_Logistics_Admin.Models.CuentaModel>
@{
    ViewBag.Title = "Cuentas";
    bool inactivos = ViewBag.Inactivos;
}

<div class="encabezado-pagina">
    <div>
        <h1 class="titulo-pagina">Cuentas</h1>
        <p class="subtitulo-pagina">Cuentas de clientes compartidas por todos los portales.</p>
    </div>
    <a class="boton boton-primario" href="@Url.Action("Crear")"><span class="icono-material" aria-hidden="true">add</span> Nueva cuenta</a>
</div>

@using (Html.BeginForm("Index", "Cuentas", FormMethod.Get, new { @class = "barra-filtros" }))
{
    <input type="text" name="buscar" value="@ViewBag.Buscar" class="control" placeholder="Buscar por nombre o código" />
    @Html.DropDownList("idGrupoCuenta", (System.Collections.Generic.IEnumerable<SelectListItem>)ViewBag.Grupos, "Todos los grupos", new { @class = "control" })
    <label class="check"><input type="checkbox" name="inactivos" value="true" @(inactivos ? "checked" : "") /> Incluir inactivas</label>
    <button type="submit" class="boton">Filtrar</button>
    <span class="contador">@Model.Count cuentas</span>
}

<section class="tarjeta tarjeta-tabla">
    <table class="tabla">
        <thead>
            <tr><th>Folio</th><th>Cuenta</th><th>Grupo</th><th>Ciudad</th><th>Sucursal</th><th>Estado</th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr class="@(c.Activo ? "" : "fila-inactiva")">
                    <td>@c.Folio</td>
                    <td><a href="@Url.Action("Detalle", new { id = c.IdCuenta })">@c.NombreComercial</a></td>
                    <td>@c.GrupoCuenta</td>
                    <td>@c.Ciudad</td>
                    <td>@c.Sucursal</td>
                    <td>@(c.Activo ? "Activa" : "Inactiva")</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="vacio">No hay cuentas con esos filtros.</td></tr>
            }
        </tbody>
    </table>
</section>
