@model EP360_Logistics_Admin.Models.CuentaModel
@{
    bool esNueva = Model.IdCuenta == 0;
    ViewBag.Title = esNueva ? "Nueva cuenta" : "Editar cuenta";
}

<h1 class="titulo-pagina">@ViewBag.Title</h1>
<p class="subtitulo-pagina">@(esNueva ? "El folio se genera automáticamente." : "Folio " + Model.Folio)</p>

<section class="tarjeta">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IdCuenta)
        @Html.ValidationSummary(true, null, new { @class = "error-formulario" })

        <div class="rejilla-formulario">
            <div class="campo campo-ancho">
                @Html.LabelFor(m => m.NombreComercial)
                @Html.TextBoxFor(m => m.NombreComercial, new { @class = "control", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.NombreComercial, null, new { @class = "error-campo" })
            </div>
            <div class="campo">
                @Html.LabelFor(m => m.CodigoCuenta)
                @Html.TextBoxFor(m => m.CodigoCuenta, new { @class = "control" })
            </div>
            <div class="campo">
                @Html.LabelFor(m => m.Rfc)
                @Html.TextBoxFor(m => m.Rfc, new { @class = "control" })
            </div>
            <div class="campo campo-ancho">
                @Html.LabelFor(m => m.RazonSocial)
                @Html.TextBoxFor(m => m.RazonSocial, new { @class = "control" })
            </div>
            <div class="campo">
                @Html.LabelFor(m => m.IdGrupoCuenta)
                @Html.DropDownListFor(m => m.IdGrupoCuenta, (System.Collections.Generic.IEnumerable<SelectListItem>)ViewBag.Grupos, "(sin grupo)", new { @class = "control" })
            </div>
            <div class="campo">
                @Html.LabelFor(m => m.IdCiudad)
                @Html.DropDownListFor(m => m.IdCiudad, (System.Collections.Generic.IEnumerable<SelectListItem>)ViewBag.Ciudades, "(sin ciudad)", new { @class = "control" })
            </div>
            <div class="campo">
                @Html.LabelFor(m => m.IdSucursal)
                @Html.DropDownListFor(m => m.IdSucursal, (System.Collections.Generic.IEnumerable<SelectListItem>)ViewBag.Sucursales, "(sin sucursal)", new { @class = "control" })
            </div>
        </div>

        <div class="acciones-formulario">
            <button type="submit" class="boton boton-primario">Guardar</button>
            <a class="boton" href="@(esNueva ? Url.Action("Index") : Url.Action("Detalle", new { id = Model.IdCuenta }))">Cancelar</a>
        </div>
    }
</section>
