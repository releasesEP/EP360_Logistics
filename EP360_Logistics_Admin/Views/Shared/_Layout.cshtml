<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - EP360 Logistics</title>
    <script>
        // Anti-parpadeo de modo oscuro: aplica el tema guardado ANTES de pintar.
        (function () {
            try { if (localStorage.getItem("portalTema") === "dark") document.documentElement.setAttribute("data-theme", "dark"); } catch (e) { }
        })();
    </script>
    <link rel="icon" href="@Url.Content("~/favicon.ico?v=2")" sizes="any" />
    <link rel="stylesheet" href="@Url.Content("~/Content/lib/bootstrap/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/lib/fontawesome/css/all.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/header-footer.css?v=2")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/ep-admin.css?v=16")" />
</head>
@{
    var controlador = (string)ViewContext.RouteData.Values["controller"];
    var accion = (string)ViewContext.RouteData.Values["action"];
    var areaDirectorio = new[] { "Personas", "Cuentas", "Grupos", "Accesos", "Sucursales" };
    var areaFlota = new[] { "Cajas", "Transportistas", "Tractores", "Choferes" };
    Func<string, string> activo = c => controlador == c ? "activo" : "";
    string area = areaDirectorio.Contains(controlador) ? "Directorio" : areaFlota.Contains(controlador) ? "Flota" : (controlador == "Sincronizacion" || controlador == "Replicacion") ? "Sistema" : null;
    string alertaReplicacion = EP360_Logistics_Admin.Helpers.AlertaReplicacion.Texto();
    string usuario = User.Identity.Name ?? "";
    string usuarioCorto = usuario.Contains("\\") ? usuario.Substring(usuario.IndexOf('\\') + 1) : usuario;
}
<body class="cuerpo-portal">

    @* Menu al estilo de EP360 Traceability (2026-11-03, pedido explicito): hamburguesa + marca "EP360 | Logistics" en el
       topbar y panel lateral navy que se desliza debajo del topbar. Abrir/cerrar en Scripts/ep-admin.js. *@
    <div id="overlay-sidebar" class="overlay-sidebar"></div>

    <!-- ================= HEADER ================= -->
    <header class="topbar">
        <button type="button" id="boton-menu-movil" class="boton-menu-movil" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar" title="Menú (tecla M)">
            <i class="fas fa-bars"></i>
        </button>
        <a href="@Url.Action("Index", "Home")" class="topbar-marca">
            <span class="marca-texto">EP<span class="marca-acento">360</span><span class="marca-separador"> | </span><span class="marca-sufijo">Logistics</span></span>
        </a>

        @if (area != null || controlador != "Home")
        {
            <div class="topbar-seccion">
                @if (area != null)
                {
                    <span>@area</span><i class="fas fa-chevron-right"></i>
                }
                <b>@ViewBag.Title</b>
            </div>
        }

        <div class="topbar-espaciador"></div>

        <div class="topbar-utilidades">
            <div class="dropdown">
                <button type="button" class="btn-nuevo-topbar" data-bs-toggle="dropdown" aria-expanded="false"><i class="fas fa-plus"></i><span class="texto-nuevo"> Nuevo</span></button>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-ep compacto">
                    <div class="dropdown-header">Directorio</div>
                    <a data-modal="lg" class="dropdown-item" href="@Url.Action("Crear", "Personas")"><i class="fas fa-user-plus"></i> Persona</a>
                    <a data-modal="lg" class="dropdown-item" href="@Url.Action("Crear", "Cuentas")"><i class="fas fa-building"></i> Cuenta</a>
                    <a data-modal class="dropdown-item" href="@Url.Action("Crear", "Grupos")"><i class="fas fa-layer-group"></i> Grupo de cuentas</a>
                    <div class="dropdown-divider"></div>
                    <div class="dropdown-header">Flota</div>
                    <a data-modal="lg" class="dropdown-item" href="@Url.Action("Crear", "Cajas")"><i class="fas fa-trailer"></i> Caja</a>
                    <a data-modal class="dropdown-item" href="@Url.Action("Crear", "Transportistas")"><i class="fas fa-truck-fast"></i> Transportista</a>
                    <a data-modal class="dropdown-item" href="@Url.Action("Crear", "Tractores")"><i class="fas fa-truck"></i> Tractor</a>
                    <a data-modal class="dropdown-item" href="@Url.Action("Crear", "Choferes")"><i class="fas fa-id-card"></i> Chofer</a>
                </div>
            </div>

            <span class="pastilla-usuario" title="Sesión de Windows: @usuario">@usuarioCorto</span>
        </div>
    </header>

    <!-- ================= MENU LATERAL ================= -->
    <aside class="sidebar" id="sidebar" aria-label="Menú principal">
        <div class="sidebar-marca">
            <small>Directorio global y flota</small>
            <button type="button" id="boton-cerrar-sidebar" class="boton-cerrar-sidebar" aria-label="Cerrar menú"><i class="fas fa-xmark"></i></button>
        </div>

        <nav class="sidebar-nav" aria-label="Navegación principal">
            <div class="grupo-nav">
                <span class="grupo-etiqueta">General</span>
                    <a class="@activo("Home")" href="@Url.Action("Index", "Home")"><i class="fas fa-gauge-high"></i> Inicio</a>
            </div>
            <div class="grupo-nav">
                <span class="grupo-etiqueta">Directorio</span>
                    <a class="@activo("Personas")" href="@Url.Action("Index", "Personas")"><i class="fas fa-users"></i> Personas</a>
                    <a class="@activo("Cuentas")" href="@Url.Action("Index", "Cuentas")"><i class="fas fa-building"></i> Cuentas</a>
                    <a class="@activo("Grupos")" href="@Url.Action("Index", "Grupos")"><i class="fas fa-layer-group"></i> Grupos de cuentas</a>
                    <a class="@activo("Accesos")" href="@Url.Action("Index", "Accesos")"><i class="fas fa-key"></i> Accesos a portales</a>
                    <a class="@activo("Sucursales")" href="@Url.Action("Index", "Sucursales")"><i class="fas fa-location-dot"></i> Sucursales</a>
            </div>
            <div class="grupo-nav">
                <span class="grupo-etiqueta">Flota</span>
                    <a class="@activo("Cajas")" href="@Url.Action("Index", "Cajas")"><i class="fas fa-trailer"></i> Cajas</a>
                    <a class="@activo("Transportistas")" href="@Url.Action("Index", "Transportistas")"><i class="fas fa-truck-fast"></i> Transportistas</a>
                    <a class="@activo("Tractores")" href="@Url.Action("Index", "Tractores")"><i class="fas fa-truck"></i> Tractores</a>
                    <a class="@activo("Choferes")" href="@Url.Action("Index", "Choferes")"><i class="fas fa-id-card"></i> Choferes</a>
            </div>
            <div class="grupo-nav">
                <span class="grupo-etiqueta">Sistema</span>
                    <a class="@activo("Sincronizacion")" href="@Url.Action("Index", "Sincronizacion")"><i class="fas fa-rotate"></i> Sincronización con AD</a>
                <a class="@activo("Replicacion")" href="@Url.Action("Index", "Replicacion")" title="@(alertaReplicacion ?? "Replicación del 60 al servidor 11")"><i class="fas fa-database"></i> Copia en el 11
                    @if (alertaReplicacion != null) { <i class="fas fa-circle-exclamation nav-alerta"></i> }
                </a>
            </div>
        </nav>

        <div class="sidebar-pie">Abre y cierra con <kbd>M</kbd> · cierra con <kbd>Esc</kbd></div>
    </aside>

    <main class="contenido-portal">
        @* Aviso visible (2026-10-09): antes el estado de la copia al 11 solo se veia dentro del menu lateral y una
           cola detenida paso un dia entero sin que nadie lo notara. Se oculta en la propia pantalla de Replicacion. *@
        @if (alertaReplicacion != null && controlador != "Replicacion")
        {
            <div class="aviso-replicacion" role="alert">
                <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                <div class="aviso-replicacion__texto">
                    <strong>La copia de datos al servidor 11 necesita atención.</strong>
                    @(alertaReplicacion). Lo que se guarda aquí queda en el 60, pero no llega al 11 hasta resolverlo.
                </div>
                <a class="aviso-replicacion__enlace" href="@Url.Action("Index", "Replicacion")">Ver y resolver</a>
            </div>
        }
        @RenderBody()
    </main>

    @* El resultado de la accion anterior se muestra con el modal del sello (Scripts/ep-admin.js). *@
    @if (TempData["Exito"] != null)
    {
        <div id="datosAviso" hidden data-tipo="exito" data-mensaje="@TempData["Exito"]"></div>
    }
    else if (TempData["Error"] != null)
    {
        <div id="datosAviso" hidden data-tipo="error" data-mensaje="@TempData["Error"]" data-cuerpo="Revisa los datos e inténtalo de nuevo."></div>
    }

    <!-- Formularios cortos (alta/edicion) que se abren en modal; el contenido llega por fetch (ep-admin.js) -->
    <div class="modal fade modal-formulario" id="modalFormulario" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:640px;"></div>
    </div>

    <!-- Resultado de una accion -->
    <div class="modal fade" id="modalResultadoAccion" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
            <div class="modal-content modal-alerta">
                <button type="button" class="btn-close modal-alerta__cerrar" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                <div class="modal-alerta__contenido">
                    <div class="marca-sello marca-sello--exito">
                        <span class="marca-sello-logo">EP<span class="marca-sello-acento">360</span></span>
                        <span class="marca-sello-badge"><span class="marca-sello-badge-anillo"><span class="marca-sello-badge-circulo"><i class="fas fa-check"></i></span></span></span>
                    </div>
                    <span class="modal-alerta__etiqueta"></span>
                    <p class="modal-alerta__mensaje"></p>
                    <p class="modal-alerta__cuerpo"></p>
                </div>
                <div class="modal-alerta__pie">
                    <button type="button" class="btn-corporativo" data-bs-dismiss="modal">Entendido</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmacion antes de una accion -->
    <div class="modal fade" id="modalConfirmarAccion" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
            <div class="modal-content modal-alerta">
                <button type="button" class="btn-close modal-alerta__cerrar" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                <div class="modal-alerta__contenido">
                    <div class="marca-sello marca-sello--peligro">
                        <span class="marca-sello-logo">EP<span class="marca-sello-acento">360</span></span>
                        <span class="marca-sello-badge"><span class="marca-sello-badge-anillo"><span class="marca-sello-badge-circulo"><i class="fas fa-triangle-exclamation"></i></span></span></span>
                    </div>
                    <span class="modal-alerta__etiqueta"></span>
                    <p class="modal-alerta__mensaje"></p>
                    <p class="modal-alerta__cuerpo"></p>
                </div>
                <div class="modal-alerta__pie">
                    <button type="button" class="btn-suave" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn-peligro" id="botonConfirmarAccion">Sí, continuar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="footer-portal">
        <div class="footer-portal-contenido">
            <div class="footer-portal-info">
                <div class="footer-portal-columna">
                    <span class="icono-material" style="font-size:14px;" aria-hidden="true">support_agent</span>
                    <div>
                        <span class="footer-portal-titulo">Soporte</span>
                        <p>¿Problemas con el portal? Contacta al departamento de Sistemas.</p>
                    </div>
                </div>
                <div class="footer-portal-columna">
                    <span class="icono-material" style="font-size:14px;" aria-hidden="true">swap_horiz</span>
                    <div>
                        <span class="footer-portal-titulo">EP<span class="marca-acento">360</span> Logistics</span>
                        <p>Administración del directorio global y la flota compartidos por los portales de EP Logistics.</p>
                    </div>
                </div>
            </div>
            <div class="footer-portal-inferior">
                <div class="footer-portal-izquierda">
                    <div class="footer-portal-redes">
                        <button type="button" id="boton-modo-oscuro" class="boton-tema" title="Modo oscuro">
                            <span class="icono-material icono-sol" style="font-size:16px;" aria-hidden="true">light_mode</span>
                            <span class="icono-material icono-luna" style="font-size:16px;" aria-hidden="true">dark_mode</span>
                        </button>
                        <a href="https://eplogistics.com/" target="_blank" rel="noopener" title="Sitio web" aria-label="Sitio web"><span class="icono-material" style="font-size:16px;" aria-hidden="true">public</span></a>
                        <a href="https://www.linkedin.com/company/ep-logistics/" target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn"><i class="fab fa-linkedin" style="font-size:16px;"></i></a>
                        <a href="https://www.facebook.com/eplogistics/" target="_blank" rel="noopener" title="Facebook" aria-label="Facebook"><i class="fab fa-facebook" style="font-size:16px;"></i></a>
                        <a href="https://www.instagram.com/ep_logistics_/" target="_blank" rel="noopener" title="Instagram" aria-label="Instagram"><i class="fab fa-instagram" style="font-size:16px;"></i></a>
                    </div>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                    <a href="@Url.Action("Novedades", "Home")" class="footer-version-pill" title="Ver las novedades del sistema"><i class="fas fa-code-branch" style="font-size:11px;"></i> v1.4.0</a>
                    <span class="footer-portal-copyright">&copy; @DateTime.Now.Year - Directorio global</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="@Url.Content("~/Content/lib/bootstrap/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/Scripts/theme.js")"></script>
    <script src="@Url.Content("~/Scripts/ep-admin.js?v=10")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
