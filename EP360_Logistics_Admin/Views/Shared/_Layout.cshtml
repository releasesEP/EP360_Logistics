<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - EP360 Logistics</title>
    <script>
        // Anti-parpadeo de modo oscuro: aplica el tema guardado ANTES de pintar.
        (function () {
            try { if (localStorage.getItem("portalTema") === "dark") document.documentElement.setAttribute("data-theme", "dark"); } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="@Url.Content("~/Content/header-footer.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/admin.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/admin-paginas.css")" />
</head>
<body class="cuerpo-portal">

    <!-- ================= HEADER ================= -->
    <header class="topbar">
        <a href="@Url.Action("Index", "Home")" class="topbar-marca">
            <span class="marca-texto">EP<span class="marca-acento">360</span></span>
            <span class="marca-subtitulo">Logistics</span>
        </a>
        @{ var controladorActual = (string)ViewContext.RouteData.Values["controller"]; }
        <nav class="topbar-nav" aria-label="Principal">
            <a href="@Url.Action("Index", "Home")" class="@(controladorActual == "Home" ? "activo" : "")">Inicio</a>
            <a href="@Url.Action("Index", "Personas")" class="@(controladorActual == "Personas" ? "activo" : "")">Personas</a>
            <a href="@Url.Action("Index", "Cuentas")" class="@(controladorActual == "Cuentas" ? "activo" : "")">Cuentas</a>
            <a href="@Url.Action("Index", "Grupos")" class="@(controladorActual == "Grupos" ? "activo" : "")">Grupos</a>
            <a href="@Url.Action("Index", "Sincronizacion")" class="@(controladorActual == "Sincronizacion" ? "activo" : "")">Sincronización</a>
            @{ var alertaReplicacion = EP360_Logistics_Admin.Helpers.AlertaReplicacion.Texto(); }
            <a href="@Url.Action("Index", "Replicacion")" class="@(controladorActual == "Replicacion" ? "activo" : "")" @(alertaReplicacion != null ? Html.Raw("title=\"" + HttpUtility.HtmlAttributeEncode(alertaReplicacion) + "\"") : null)>Replicación @if (alertaReplicacion != null) { <span class="insignia insignia-error" aria-label="@alertaReplicacion">!</span> }</a>
        </nav>
        <div class="topbar-espaciador"></div>
        <div class="topbar-utilidades">
            <span class="enlace-cambiar-usuario" title="Sesion de Windows">
                <span class="icono-material" style="font-size:16px;" aria-hidden="true">person</span>
                <span>@User.Identity.Name</span>
            </span>
        </div>
    </header>

    <main class="contenido-portal">
        @if (TempData["Exito"] != null)
        {
            <div class="aviso aviso-ok" role="status">@TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="aviso aviso-error" role="alert">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="footer-portal">
        <div class="footer-portal-contenido">
            <div class="footer-portal-info">
                <div class="footer-portal-columna">
                    <span class="icono-material" style="font-size:14px;" aria-hidden="true">support_agent</span>
                    <div>
                        <span class="footer-portal-titulo">Soporte</span>
                        <p>¿Problemas con el portal? Contacta al departamento de Sistemas.</p>
                    </div>
                </div>
                <div class="footer-portal-columna">
                    <span class="icono-material" style="font-size:14px;" aria-hidden="true">swap_horiz</span>
                    <div>
                        <span class="footer-portal-titulo">EP<span class="marca-acento">360</span> Logistics</span>
                        <p>Administración del directorio global compartido por los portales de EP Logistics.</p>
                    </div>
                </div>
            </div>
            <div class="footer-portal-inferior">
                <div class="footer-portal-izquierda">
                    <div class="footer-portal-redes">
                        <button type="button" id="boton-modo-oscuro" class="boton-tema" title="Modo oscuro">
                            <span class="icono-material icono-sol" style="font-size:16px;" aria-hidden="true">light_mode</span>
                            <span class="icono-material icono-luna" style="font-size:16px;" aria-hidden="true">dark_mode</span>
                        </button>
                        <a href="https://eplogistics.com/" target="_blank" rel="noopener" title="Sitio web" aria-label="Sitio web"><span class="icono-material" style="font-size:16px;" aria-hidden="true">public</span></a>
                        <a href="https://www.linkedin.com/company/ep-logistics/" target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
                        <a href="https://www.facebook.com/eplogistics/" target="_blank" rel="noopener" title="Facebook" aria-label="Facebook"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M22.675 0H1.325C.593 0 0 .593 0 1.326v21.348C0 23.407.593 24 1.325 24h11.495v-9.294H9.691v-3.622h3.129V8.413c0-3.1 1.894-4.788 4.659-4.788 1.325 0 2.464.099 2.795.143v3.24h-1.918c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.593 1.323-1.326V1.326C24 .593 23.407 0 22.675 0z"/></svg></a>
                        <a href="https://www.instagram.com/ep_logistics_/" target="_blank" rel="noopener" title="Instagram" aria-label="Instagram"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>
                    </div>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                    <span class="footer-version-pill" title="Versión del sistema">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><circle cx="6" cy="5" r="2.3" /><circle cx="6" cy="19" r="2.3" /><circle cx="18" cy="12" r="2.3" /><path d="M6 7.3V16.7" stroke="currentColor" stroke-width="1.8" fill="none" /><path d="M6 8C6 11 9 12 15.7 12" stroke="currentColor" stroke-width="1.8" fill="none" /></svg>
                        1.0.0
                    </span>
                    <span class="footer-portal-copyright">&copy; @DateTime.Now.Year - Directorio global</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="@Url.Content("~/Scripts/theme.js")"></script>
</body>
</html>
