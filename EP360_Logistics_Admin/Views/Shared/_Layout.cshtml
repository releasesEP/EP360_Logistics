<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - EP360 Logistics</title>
    <script>
        // Anti-parpadeo de modo oscuro: aplica el tema guardado ANTES de pintar.
        (function () {
            try { if (localStorage.getItem("portalTema") === "dark") document.documentElement.setAttribute("data-theme", "dark"); } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="@Url.Content("~/Content/lib/bootstrap/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/lib/fontawesome/css/all.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/header-footer.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/ep-admin.css?v=5")" />
</head>
@{
    var controlador = (string)ViewContext.RouteData.Values["controller"];
    var accion = (string)ViewContext.RouteData.Values["action"];
    var areaDirectorio = new[] { "Personas", "Cuentas", "Grupos", "Accesos", "Sucursales" };
    var areaFlota = new[] { "Cajas", "Transportistas", "Tractores", "Choferes" };
    Func<string, string> activo = c => controlador == c ? "activo" : "";
    string area = areaDirectorio.Contains(controlador) ? "Directorio" : areaFlota.Contains(controlador) ? "Flota" : (controlador == "Sincronizacion" || controlador == "Replicacion") ? "Sistema" : null;
    string alertaReplicacion = EP360_Logistics_Admin.Helpers.AlertaReplicacion.Texto();
    string usuario = User.Identity.Name ?? "";
    string usuarioCorto = usuario.Contains("\\") ? usuario.Substring(usuario.IndexOf('\\') + 1) : usuario;
}
<body class="cuerpo-portal">

    <!-- ================= HEADER ================= -->
    <header class="topbar">
        <button type="button" class="boton-marca" data-bs-toggle="offcanvas" data-bs-target="#menuPanel" aria-controls="menuPanel" aria-expanded="false" title="Abrir menú (tecla M)">
            <span class="hamburguesa" aria-hidden="true"><span></span><span></span><span></span></span>
            <span><span class="marca-texto">EP<span class="marca-acento">360</span></span><span class="marca-subtitulo">Logistics</span></span>
        </button>

        @if (area != null || controlador != "Home")
        {
            <div class="topbar-seccion">
                @if (area != null)
                {
                    <span>@area</span><i class="fas fa-chevron-right"></i>
                }
                <b>@ViewBag.Title</b>
            </div>
        }

        <div class="topbar-espaciador"></div>

        <div class="dropdown">
            <button type="button" class="btn-nuevo-topbar" data-bs-toggle="dropdown" aria-expanded="false"><i class="fas fa-plus"></i><span class="texto-nuevo"> Nuevo</span></button>
            <div class="dropdown-menu dropdown-menu-end dropdown-menu-ep compacto">
                <div class="dropdown-header">Directorio</div>
                <a class="dropdown-item" href="@Url.Action("Crear", "Personas")"><i class="fas fa-user-plus"></i> Persona</a>
                <a class="dropdown-item" href="@Url.Action("Crear", "Cuentas")"><i class="fas fa-building"></i> Cuenta</a>
                <a class="dropdown-item" href="@Url.Action("Crear", "Grupos")"><i class="fas fa-layer-group"></i> Grupo de cuentas</a>
                <a class="dropdown-item" href="@Url.Action("Crear", "Sucursales")"><i class="fas fa-location-dot"></i> Sucursal</a>
                <div class="dropdown-divider"></div>
                <div class="dropdown-header">Flota</div>
                <a class="dropdown-item" href="@Url.Action("Crear", "Cajas")"><i class="fas fa-trailer"></i> Caja</a>
                <a class="dropdown-item" href="@Url.Action("Crear", "Transportistas")"><i class="fas fa-truck-fast"></i> Transportista</a>
                <a class="dropdown-item" href="@Url.Action("Crear", "Tractores")"><i class="fas fa-truck"></i> Tractor</a>
                <a class="dropdown-item" href="@Url.Action("Crear", "Choferes")"><i class="fas fa-id-card"></i> Chofer</a>
            </div>
        </div>

        <span class="pastilla-usuario" title="Sesión de Windows: @usuario">
            <span class="avatar-usuario">@TextoUtil.Iniciales(usuarioCorto)</span>
            <span class="nombre-usuario">@usuarioCorto</span>
        </span>
    </header>

    <!-- ================= MENU DESPLEGABLE (se abre con la marca) ================= -->
    <aside class="offcanvas offcanvas-start menu-panel" tabindex="-1" id="menuPanel" aria-label="Menú principal">
        <div class="offcanvas-header">
            <button type="button" class="boton-marca" data-bs-dismiss="offcanvas" aria-label="Cerrar menú">
                <span class="hamburguesa" aria-hidden="true"><span></span><span></span><span></span></span>
                <span><span class="marca-texto">EP<span class="marca-acento">360</span></span><span class="marca-subtitulo">Logistics</span></span>
            </button>
        </div>
        <div class="offcanvas-body">
            <nav>
                <a class="menu-enlace @activo("Home")" style="--i:0" href="@Url.Action("Index", "Home")">
                    <span class="menu-enlace-icono"><i class="fas fa-gauge-high"></i></span>
                    <span class="menu-enlace-texto"><strong>Inicio</strong><small>Tablero del directorio y la flota</small></span>
                    <i class="fas fa-chevron-right menu-enlace-flecha"></i>
                </a>

                <div class="menu-seccion">Directorio</div>
                <a class="menu-enlace @activo("Personas")" style="--i:1" href="@Url.Action("Index", "Personas")">
                    <span class="menu-enlace-icono"><i class="fas fa-users"></i></span>
                    <span class="menu-enlace-texto"><strong>Personas</strong><small>Usuarios de AD, externos y contactos</small></span>
                    <i class="fas fa-chevron-right menu-enlace-flecha"></i>
                </a>
                <a class="menu-enlace @activo("Cuentas")" style="--i:2" href="@Url.Action("Index", "Cuentas")">
                    <span class="menu-enlace-icono"><i class="fas fa-building"></i></span>
                    <span class="menu-enlace-texto"><strong>Cuentas</strong><small>Clientes y sus contactos</small></span>
                    <i class="fas fa-chevron-right menu-enlace-flecha"></i>
                </a>
                <a class="menu-enlace @activo("Grupos")" style="--i:3" href="@Url.Action("Index", "Grupos")">
                    <span class="menu-enlace-icono"><i class="fas fa-layer-group"></i></span>
                    <span class="menu-enlace-texto"><strong>Grupos de cuentas</strong><small>Un cliente con varias cuentas</small></span>
                    <i class="fas fa-chevron-right menu-enlace-flecha"></i>
                </a>

                <a class="menu-enlace @activo("Accesos")" style="--i:3" href="@Url.Action("Index", "Accesos")">
                    <span class="menu-enlace-icono"><i class="fas fa-key"></i></span>
                    <span class="menu-enlace-texto"><strong>Accesos a portales</strong><small>Quién entra a EP360, Balance, Help Desk...</small></span>
                    <i class="fas fa-chevron-right menu-enlace-flecha"></i>
                </a>

                <a class="menu-enlace @activo("Sucursales")" style="--i:3" href="@Url.Action("Index", "Sucursales")">
                    <span class="menu-enlace-icono"><i class="fas fa-location-dot"></i></span>
                    <span class="menu-enlace-texto"><strong>Sucursales</strong><small>Catálogo compartido por los portales</small></span>
                    <i class="fas fa-chevron-right menu-enlace-flecha"></i>
                </a>

                <div class="menu-seccion">Flota</div>
                <a class="menu-enlace @activo("Cajas")" style="--i:4" href="@Url.Action("Index", "Cajas")">
                    <span class="menu-enlace-icono"><i class="fas fa-trailer"></i></span>
                    <span class="menu-enlace-texto"><strong>Cajas</strong><small>Trailers de clientes, transportistas y EP</small></span>
                    <i class="fas fa-chevron-right menu-enlace-flecha"></i>
                </a>
                <a class="menu-enlace @activo("Transportistas")" style="--i:5" href="@Url.Action("Index", "Transportistas")">
                    <span class="menu-enlace-icono"><i class="fas fa-truck-fast"></i></span>
                    <span class="menu-enlace-texto"><strong>Transportistas</strong><small>Líneas con sus tractores y choferes</small></span>
                    <i class="fas fa-chevron-right menu-enlace-flecha"></i>
                </a>
                <a class="menu-enlace @activo("Tractores")" style="--i:6" href="@Url.Action("Index", "Tractores")">
                    <span class="menu-enlace-icono"><i class="fas fa-truck"></i></span>
                    <span class="menu-enlace-texto"><strong>Tractores</strong><small>Económicos de cada transportista</small></span>
                    <i class="fas fa-chevron-right menu-enlace-flecha"></i>
                </a>
                <a class="menu-enlace @activo("Choferes")" style="--i:7" href="@Url.Action("Index", "Choferes")">
                    <span class="menu-enlace-icono"><i class="fas fa-id-card"></i></span>
                    <span class="menu-enlace-texto"><strong>Choferes</strong><small>Operadores y con quién trabajan</small></span>
                    <i class="fas fa-chevron-right menu-enlace-flecha"></i>
                </a>

                <div class="menu-seccion">Sistema</div>
                <a class="menu-enlace @activo("Sincronizacion")" style="--i:8" href="@Url.Action("Index", "Sincronizacion")">
                    <span class="menu-enlace-icono"><i class="fas fa-rotate"></i></span>
                    <span class="menu-enlace-texto"><strong>Sincronización con AD</strong><small>Trae los usuarios del dominio</small></span>
                    <i class="fas fa-chevron-right menu-enlace-flecha"></i>
                </a>
                <a class="menu-enlace @activo("Replicacion")" style="--i:9" href="@Url.Action("Index", "Replicacion")">
                    <span class="menu-enlace-icono"><i class="fas fa-database"></i></span>
                    <span class="menu-enlace-texto"><strong>Copia en el 11</strong><small>@(alertaReplicacion ?? "Replicación del 60 al servidor 11")</small></span>
                    @if (alertaReplicacion != null) { <i class="fas fa-circle-exclamation" style="color:#c0392b;" title="@alertaReplicacion"></i> } else { <i class="fas fa-chevron-right menu-enlace-flecha"></i> }
                </a>
            </nav>

            <div class="menu-panel-pie">
                <div class="menu-panel-usuario" title="Sesión de Windows: @usuario">
                    <span class="avatar-usuario">@TextoUtil.Iniciales(usuarioCorto)</span>
                    <span><strong>@usuarioCorto</strong><small>Administrador del directorio global</small></span>
                </div>
                <div class="atajo">Abre y cierra este menú con <kbd>M</kbd> · cierra con <kbd>Esc</kbd></div>
            </div>
        </div>
    </aside>

    <main class="contenido-portal">
        @RenderBody()
    </main>

    @* El resultado de la accion anterior se muestra con el modal del sello (Scripts/ep-admin.js). *@
    @if (TempData["Exito"] != null)
    {
        <div id="datosAviso" hidden data-tipo="exito" data-mensaje="@TempData["Exito"]"></div>
    }
    else if (TempData["Error"] != null)
    {
        <div id="datosAviso" hidden data-tipo="error" data-mensaje="@TempData["Error"]" data-cuerpo="Revisa los datos e inténtalo de nuevo."></div>
    }

    <!-- Resultado de una accion -->
    <div class="modal fade" id="modalResultadoAccion" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
            <div class="modal-content modal-alerta">
                <button type="button" class="btn-close modal-alerta__cerrar" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                <div class="modal-alerta__contenido">
                    <div class="marca-sello marca-sello--exito">
                        <span class="marca-sello-logo">EP<span class="marca-sello-acento">360</span></span>
                        <span class="marca-sello-badge"><span class="marca-sello-badge-anillo"><span class="marca-sello-badge-circulo"><i class="fas fa-check"></i></span></span></span>
                    </div>
                    <span class="modal-alerta__etiqueta"></span>
                    <p class="modal-alerta__mensaje"></p>
                    <p class="modal-alerta__cuerpo"></p>
                </div>
                <div class="modal-alerta__pie">
                    <button type="button" class="btn-corporativo" data-bs-dismiss="modal">Entendido</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmacion antes de una accion -->
    <div class="modal fade" id="modalConfirmarAccion" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
            <div class="modal-content modal-alerta">
                <button type="button" class="btn-close modal-alerta__cerrar" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                <div class="modal-alerta__contenido">
                    <div class="marca-sello marca-sello--peligro">
                        <span class="marca-sello-logo">EP<span class="marca-sello-acento">360</span></span>
                        <span class="marca-sello-badge"><span class="marca-sello-badge-anillo"><span class="marca-sello-badge-circulo"><i class="fas fa-triangle-exclamation"></i></span></span></span>
                    </div>
                    <span class="modal-alerta__etiqueta"></span>
                    <p class="modal-alerta__mensaje"></p>
                    <p class="modal-alerta__cuerpo"></p>
                </div>
                <div class="modal-alerta__pie">
                    <button type="button" class="btn-suave" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn-peligro" id="botonConfirmarAccion">Sí, continuar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="footer-portal">
        <div class="footer-portal-contenido">
            <div class="footer-portal-info">
                <div class="footer-portal-columna">
                    <span class="icono-material" style="font-size:14px;" aria-hidden="true">support_agent</span>
                    <div>
                        <span class="footer-portal-titulo">Soporte</span>
                        <p>¿Problemas con el portal? Contacta al departamento de Sistemas.</p>
                    </div>
                </div>
                <div class="footer-portal-columna">
                    <span class="icono-material" style="font-size:14px;" aria-hidden="true">swap_horiz</span>
                    <div>
                        <span class="footer-portal-titulo">EP<span class="marca-acento">360</span> Logistics</span>
                        <p>Administración del directorio global y la flota compartidos por los portales de EP Logistics.</p>
                    </div>
                </div>
            </div>
            <div class="footer-portal-inferior">
                <div class="footer-portal-izquierda">
                    <div class="footer-portal-redes">
                        <button type="button" id="boton-modo-oscuro" class="boton-tema" title="Modo oscuro">
                            <span class="icono-material icono-sol" style="font-size:16px;" aria-hidden="true">light_mode</span>
                            <span class="icono-material icono-luna" style="font-size:16px;" aria-hidden="true">dark_mode</span>
                        </button>
                        <a href="https://eplogistics.com/" target="_blank" rel="noopener" title="Sitio web" aria-label="Sitio web"><span class="icono-material" style="font-size:16px;" aria-hidden="true">public</span></a>
                        <a href="https://www.linkedin.com/company/ep-logistics/" target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn"><i class="fab fa-linkedin" style="font-size:16px;"></i></a>
                        <a href="https://www.facebook.com/eplogistics/" target="_blank" rel="noopener" title="Facebook" aria-label="Facebook"><i class="fab fa-facebook" style="font-size:16px;"></i></a>
                        <a href="https://www.instagram.com/ep_logistics_/" target="_blank" rel="noopener" title="Instagram" aria-label="Instagram"><i class="fab fa-instagram" style="font-size:16px;"></i></a>
                    </div>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                    <span class="footer-version-pill" title="Versión del sistema"><i class="fas fa-code-branch" style="font-size:11px;"></i> 1.1.0</span>
                    <span class="footer-portal-copyright">&copy; @DateTime.Now.Year - Directorio global</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="@Url.Content("~/Content/lib/bootstrap/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/Scripts/theme.js")"></script>
    <script src="@Url.Content("~/Scripts/ep-admin.js?v=5")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
