@model EP360_Logistics_Admin.Models.InicioModel
@{
    ViewBag.Title = "Inicio";
    var e = Model.Estado;
    var sync = Model.UltimaSincronizacion;
    string saludo = DateTime.Now.Hour < 12 ? "Buenos días" : DateTime.Now.Hour < 19 ? "Buenas tardes" : "Buenas noches";
    var cultura = new System.Globalization.CultureInfo("es-MX");
    string fechaLarga = DateTime.Now.ToString("dddd d 'de' MMMM 'de' yyyy", cultura);
    fechaLarga = char.ToUpper(fechaLarga[0]) + fechaLarga.Substring(1);

    // Estado de cada pieza para el panel derecho del encabezado.
    bool replicaConfigurada = EP360_Logistics_Admin.DAL.Infraestructura.Replicador.Configurada;
    string alertaReplica = replicaConfigurada ? EP360_Logistics_Admin.Helpers.AlertaReplicacion.Texto() : null;
    bool syncBien = sync != null && sync.Estado == "Terminada";
    string syncTexto = sync == null ? "Nunca se ha corrido"
        : (sync.FechaInicio.Date == DateTime.Today ? "Hoy " : sync.FechaInicio.Date == DateTime.Today.AddDays(-1) ? "Ayer " : sync.FechaInicio.ToString("dd/MM ")) + sync.FechaInicio.ToString("HH:mm")
          + " · " + (sync.Estado == "Terminada" ? "sin errores" : sync.Estado == "ConErrores" ? "con errores" : sync.Estado.ToLower());
    string nombresPortales = string.Join(", ", e.Portales.Select(x => x.Nombre.Split('(')[0].Trim()));
    int unidadesFlota = Model.CajasActivas + Model.TractoresActivos;
    var alertas = (System.Collections.Generic.List<EP360_Logistics_Admin.Models.AlertaInicioModel>)ViewBag.Alertas
                  ?? new System.Collections.Generic.List<EP360_Logistics_Admin.Models.AlertaInicioModel>();
    int criticas = alertas.Count(a => a.Critica);
    // Huella del conjunto de alertas: el modal sale solo una vez por sesion para las mismas alertas.
    string huellaAlertas = string.Join("|", alertas.Select(a => a.Titulo)).GetHashCode().ToString("x");
}

<section class="inicio-hero">
    <div class="inicio-hero-principal">
        <span class="inicio-hero-marca">EP<b>360</b> · Logistics <span>Directorio global</span></span>
        <h1>@saludo@(string.IsNullOrWhiteSpace((string)ViewBag.NombreSaludo) ? "" : ", " + (string)ViewBag.NombreSaludo)</h1>
        <div class="inicio-hero-fecha">@fechaLarga</div>
        <p>
            La fuente única de personas, clientes y flota de EP Logistics. Todo lo que se registra aquí lo consultan
            @(e.Conectado && e.Portales.Count > 0 ? nombresPortales : "los portales de la empresa"): un solo directorio,
            sincronizado con Active Directory y con copia en el servidor 11.
        </p>
        @if (e.Conectado)
        {
            <div class="inicio-hero-cifras">
                <a href="@Url.Action("Index", "Personas")"><strong>@Model.PersonasActivas.ToString("N0")</strong><span>personas activas</span><small>@Model.UsuariosAD.ToString("N0") del dominio · @Model.UsuariosExternos.ToString("N0") externas</small></a>
                <a href="@Url.Action("Index", "Cuentas")"><strong>@Model.CuentasActivas.ToString("N0")</strong><span>cuentas de clientes</span><small>en @Model.GruposActivos.ToString("N0") grupos</small></a>
                <a href="@Url.Action("Index", "Cajas")"><strong>@unidadesFlota.ToString("N0")</strong><span>unidades de flota</span><small>@Model.CajasActivas.ToString("N0") cajas · @Model.TractoresActivos.ToString("N0") tractores</small></a>
                <div><strong>@e.PortalesActivos</strong><span>portales conectados</span><small>leen este directorio</small></div>
            </div>
        }
    </div>

    <aside class="inicio-hero-estado" aria-label="Estado del sistema">
        <div class="inicio-hero-estado-titulo">Estado del sistema</div>
        @if (alertas.Count > 0)
        {
            <button type="button" class="inicio-alertas-boton @(criticas > 0 ? "critica" : "")" data-bs-toggle="modal" data-bs-target="#modalAlertasInicio">
                <span class="punto"></span>@alertas.Count @(alertas.Count == 1 ? "alerta por revisar" : "alertas por revisar")
            </button>
        }
        <ul>
            <li class="@(e.Conectado ? "ok" : "mal")">
                <span class="punto"></span>
                <div><b>Base de datos</b><small>@(e.Conectado ? e.BaseDatos + " · en línea" : "Sin conexión")</small></div>
            </li>
            <li class="@(sync == null ? "neutro" : syncBien ? "ok" : "mal")">
                <span class="punto"></span>
                <div><b>Active Directory</b><small><a href="@Url.Action("Index", "Sincronizacion")">@syncTexto</a></small></div>
            </li>
            <li class="@(!replicaConfigurada ? "neutro" : alertaReplica == null ? "ok" : "mal")">
                <span class="punto"></span>
                <div><b>Copia en el servidor 11</b><small>@(!replicaConfigurada ? "No configurada en este servidor" : alertaReplica == null ? "Al día" : alertaReplica)</small></div>
            </li>
            <li class="@(e.Conectado && e.PortalesActivos > 0 ? "ok" : "neutro")">
                <span class="punto"></span>
                <div><b>Portales</b><small>@(e.Conectado ? string.Join(" · ", e.Portales.Select(x => x.Clave)) : "—")</small></div>
            </li>
        </ul>
        @if (e.Conectado)
        {
            <div class="inicio-hero-servidor">@e.Servidor · hora del servidor @e.FechaServidor.ToString("HH:mm")</div>
        }
    </aside>
</section>

@if (!e.Conectado)
{
    <div class="tarjeta-ep">
        <div class="tarjeta-ep-encabezado"><h6><i class="fas fa-triangle-exclamation"></i> No se pudo leer la base global</h6></div>
        <div class="tarjeta-ep-cuerpo">
            <p class="mb-2">Verifica que se hayan corrido los scripts de <code>Database/</code> en el servidor 60 y que la cuenta de la aplicación tenga permiso de ejecución sobre <code>dir.sp_ObtenerEstadoBase</code>.</p>
            <pre class="detalle-error">@e.Error</pre>
        </div>
    </div>
}
else
{
    if (Model.ErrorIndicadores != null)
    {
        <div class="aviso-ep aviso-ambar mb-3"><i class="fas fa-triangle-exclamation"></i><div>Algunos indicadores no se pudieron calcular: @Model.ErrorIndicadores</div></div>
    }

    <h6 class="seccion-titulo">Directorio</h6>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2"><a class="kpi-tile" href="@Url.Action("Index", "Personas")"><div class="kpi-tile-icono" style="--kpi-color:#0b1b3d;"><i class="fas fa-users"></i></div><div class="kpi-tile-etiqueta">Personas</div><div class="kpi-tile-valor">@Model.PersonasActivas.ToString("N0")</div><span class="kpi-tile-detalle">activas</span></a></div>
        <div class="col-6 col-md-4 col-xl-2"><a class="kpi-tile" href="@Url.Action("Index", "Personas", new { tipo = "AD" })"><div class="kpi-tile-icono" style="--kpi-color:#1d4ed8;"><i class="fab fa-windows"></i></div><div class="kpi-tile-etiqueta">Usuarios AD</div><div class="kpi-tile-valor">@Model.UsuariosAD.ToString("N0")</div><span class="kpi-tile-detalle">del dominio</span></a></div>
        <div class="col-6 col-md-4 col-xl-2"><a class="kpi-tile" href="@Url.Action("Index", "Personas", new { tipo = "Externo" })"><div class="kpi-tile-icono" style="--kpi-color:#1d6fd1;"><i class="fas fa-key"></i></div><div class="kpi-tile-etiqueta">Externos</div><div class="kpi-tile-valor">@Model.UsuariosExternos.ToString("N0")</div><span class="kpi-tile-detalle">con contraseña propia</span></a></div>
        <div class="col-6 col-md-4 col-xl-2"><a class="kpi-tile" href="@Url.Action("Index", "Personas", new { tipo = "Contacto" })"><div class="kpi-tile-icono" style="--kpi-color:#d97706;"><i class="fas fa-address-card"></i></div><div class="kpi-tile-etiqueta">Contactos</div><div class="kpi-tile-valor">@Model.Contactos.ToString("N0")</div><span class="kpi-tile-detalle">de clientes</span></a></div>
        <div class="col-6 col-md-4 col-xl-2"><a class="kpi-tile" href="@Url.Action("Index", "Cuentas")"><div class="kpi-tile-icono" style="--kpi-color:#0f4c9e;"><i class="fas fa-building"></i></div><div class="kpi-tile-etiqueta">Cuentas</div><div class="kpi-tile-valor">@Model.CuentasActivas.ToString("N0")</div><span class="kpi-tile-detalle">@Model.CuentasSinGrupo.ToString("N0") sin grupo</span></a></div>
        <div class="col-6 col-md-4 col-xl-2"><a class="kpi-tile" href="@Url.Action("Index", "Grupos")"><div class="kpi-tile-icono" style="--kpi-color:#0f4c9e;"><i class="fas fa-layer-group"></i></div><div class="kpi-tile-etiqueta">Grupos</div><div class="kpi-tile-valor">@Model.GruposActivos.ToString("N0")</div><span class="kpi-tile-detalle">de cuentas</span></a></div>
    </div>

    <h6 class="seccion-titulo">Flota</h6>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2"><a class="kpi-tile" href="@Url.Action("Index", "Cajas")"><div class="kpi-tile-icono" style="--kpi-color:#0b1b3d;"><i class="fas fa-trailer"></i></div><div class="kpi-tile-etiqueta">Cajas</div><div class="kpi-tile-valor">@Model.CajasActivas.ToString("N0")</div><span class="kpi-tile-detalle">activas</span></a></div>
        <div class="col-6 col-md-4 col-xl-2"><a class="kpi-tile" href="@Url.Action("Index", "Cajas", new { tipoPropiedad = "Cliente" })"><div class="kpi-tile-icono" style="--kpi-color:#1d4ed8;"><i class="fas fa-building"></i></div><div class="kpi-tile-etiqueta">De cliente</div><div class="kpi-tile-valor">@Model.CajasCliente.ToString("N0")</div><span class="kpi-tile-detalle">@Model.CajasTransportista.ToString("N0") de transportista · @Model.CajasEP.ToString("N0") EP</span></a></div>
        <div class="col-6 col-md-4 col-xl-2"><a class="kpi-tile" href="@Url.Action("Index", "Transportistas")"><div class="kpi-tile-icono" style="--kpi-color:#d97706;"><i class="fas fa-truck-fast"></i></div><div class="kpi-tile-etiqueta">Transportistas</div><div class="kpi-tile-valor">@Model.TransportistasActivos.ToString("N0")</div><span class="kpi-tile-detalle">líneas activas</span></a></div>
        <div class="col-6 col-md-4 col-xl-2"><a class="kpi-tile" href="@Url.Action("Index", "Tractores")"><div class="kpi-tile-icono" style="--kpi-color:#64748b;"><i class="fas fa-truck"></i></div><div class="kpi-tile-etiqueta">Tractores</div><div class="kpi-tile-valor">@Model.TractoresActivos.ToString("N0")</div><span class="kpi-tile-detalle">activos</span></a></div>
        <div class="col-6 col-md-4 col-xl-2"><a class="kpi-tile" href="@Url.Action("Index", "Choferes")"><div class="kpi-tile-icono" style="--kpi-color:#16a34a;"><i class="fas fa-id-card"></i></div><div class="kpi-tile-etiqueta">Choferes</div><div class="kpi-tile-valor">@Model.ChoferesActivos.ToString("N0")</div><span class="kpi-tile-detalle">activos</span></a></div>
        <div class="col-6 col-md-4 col-xl-2"><a class="kpi-tile" href="@Url.Action("Index", "Choferes")"><div class="kpi-tile-icono" style="--kpi-color:#1d6fd1;"><i class="fas fa-shuffle"></i></div><div class="kpi-tile-etiqueta">Multilínea</div><div class="kpi-tile-valor">@Model.ChoferesVariosTransportistas.ToString("N0")</div><span class="kpi-tile-detalle">choferes con 2+ transportistas</span></a></div>
    </div>

    <div class="row g-3 mb-2">
        <div class="col-lg-4">
            <div class="tarjeta-ep h-100 mb-0">
                <div class="tarjeta-ep-encabezado"><h6><i class="fas fa-trailer"></i> Clientes con más cajas</h6></div>
                <div class="tarjeta-ep-cuerpo">
                    @Barras(Model.CajasPorGrupo, b => b.Id.HasValue ? Url.Action("Detalle", "Grupos", new { id = b.Id }) : Url.Action("Index", "Cajas"), "Todavía no hay cajas de cliente.")
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="tarjeta-ep h-100 mb-0">
                <div class="tarjeta-ep-encabezado"><h6><i class="fas fa-truck-fast"></i> Transportistas con más choferes</h6></div>
                <div class="tarjeta-ep-cuerpo">
                    @Barras(Model.TransportistasPorChoferes, b => Url.Action("Detalle", "Transportistas", new { id = b.Id }), "Todavía no hay transportistas.")
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="tarjeta-ep h-100 mb-0">
                <div class="tarjeta-ep-encabezado"><h6><i class="fas fa-location-dot"></i> Personas por sucursal</h6></div>
                <div class="tarjeta-ep-cuerpo">
                    @Barras(Model.PersonasPorSucursal, b => Url.Action("Index", "Personas", new { idSucursal = b.Id }), "Sin datos.")
                </div>
            </div>
        </div>
    </div>

    <h6 class="seccion-titulo mt-4">Accesos rápidos</h6>
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3"><a data-modal="lg" class="acceso-ep" href="@Url.Action("Crear", "Personas")"><span class="acceso-icono"><i class="fas fa-user-plus"></i></span><span><strong>Dar de alta una persona</strong><small>Contacto o usuario externo</small></span><i class="fas fa-chevron-right acceso-flecha"></i></a></div>
        <div class="col-md-6 col-xl-3"><a data-modal="lg" class="acceso-ep" href="@Url.Action("Crear", "Cajas")"><span class="acceso-icono"><i class="fas fa-trailer"></i></span><span><strong>Registrar una caja</strong><small>De cliente, transportista o EP</small></span><i class="fas fa-chevron-right acceso-flecha"></i></a></div>
        <div class="col-md-6 col-xl-3"><a data-modal class="acceso-ep" href="@Url.Action("Crear", "Choferes")"><span class="acceso-icono"><i class="fas fa-id-card"></i></span><span><strong>Dar de alta un chofer</strong><small>Y ligarlo a sus transportistas</small></span><i class="fas fa-chevron-right acceso-flecha"></i></a></div>
        <div class="col-md-6 col-xl-3"><a class="acceso-ep" href="@Url.Action("Index", "Sincronizacion")"><span class="acceso-icono"><i class="fas fa-rotate"></i></span><span><strong>Sincronizar con AD</strong><small>@(sync != null ? "Última: " + sync.FechaInicio.ToString("dd/MM HH:mm") + " · " + sync.Estado : "Nunca se ha corrido")</small></span><i class="fas fa-chevron-right acceso-flecha"></i></a></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="tarjeta-ep h-100 mb-0">
                <div class="tarjeta-ep-encabezado"><h6><i class="fas fa-database"></i> Base de datos conectada</h6><span class="pastilla pastilla-verde"><i class="fas fa-circle"></i>En línea</span></div>
                <div class="tarjeta-ep-cuerpo">
                    <dl class="datos-ep">
                        <div><dt>Base</dt><dd>@e.BaseDatos</dd></div>
                        <div><dt>Servidor</dt><dd>@e.Servidor</dd></div>
                        <div><dt>Edición</dt><dd>@e.Edicion</dd></div>
                        <div><dt>Hora del servidor</dt><dd>@e.FechaServidor.ToString("yyyy-MM-dd HH:mm:ss")</dd></div>
                        <div><dt>Tablas dir / seg / sync</dt><dd>@e.TablasDir / @e.TablasSeg / @e.TablasSync</dd></div>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="tarjeta-ep h-100 mb-0">
                <div class="tarjeta-ep-encabezado"><h6><i class="fas fa-plug"></i> Portales registrados <span class="contador">@e.PortalesActivos</span></h6></div>
                <div class="tarjeta-ep-cuerpo p-0">
                    <table class="tabla-ep">
                        <tbody>
                            @foreach (var portal in e.Portales)
                            {
                                <tr><td style="width:120px;"><span class="pastilla pastilla-navy">@portal.Clave</span></td><td>@portal.Nombre</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}


@if (alertas.Count > 0)
{
    @* Modal de alertas: sale al entrar al inicio si algo fallo (una vez por sesion para el mismo conjunto de alertas). *@
    <div class="modal fade" id="modalAlertasInicio" tabindex="-1" aria-labelledby="tituloAlertasInicio" aria-hidden="true" data-huella="@huellaAlertas">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content alertas-inicio">
                <div class="alertas-inicio-cabecera @(criticas > 0 ? "critica" : "")">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    <span class="alertas-inicio-ruta">EP<b>360</b> · Logistics · Estado del sistema</span>
                    <h2 id="tituloAlertasInicio">@(alertas.Count == 1 ? "Hay 1 cosa que revisar" : "Hay " + alertas.Count + " cosas que revisar")</h2>
                    <p>
                        @if (criticas > 0)
                        {
                            <span>@criticas @(criticas == 1 ? "es crítica" : "son críticas") y @(criticas == 1 ? "afecta" : "afectan") a los portales que usan el directorio.</span>
                        }
                        else
                        {
                            <span>Nada está detenido, pero conviene revisarlo.</span>
                        }
                    </p>
                </div>
                <ul class="alertas-inicio-lista">
                    @foreach (var a in alertas)
                    {
                        <li class="@(a.Critica ? "critica" : "")">
                            <span class="alertas-inicio-nivel">@(a.Critica ? "Crítica" : "Revisar")</span>
                            <div class="alertas-inicio-texto">
                                <span class="alertas-inicio-area">@a.Area</span>
                                <b>@a.Titulo</b>
                                @if (!string.IsNullOrEmpty(a.Detalle)) { <small>@a.Detalle</small> }
                            </div>
                            @if (a.UrlAccion != null)
                            {
                                <a class="alertas-inicio-accion" href="@a.UrlAccion">@a.TextoAccion</a>
                            }
                        </li>
                    }
                </ul>
                <div class="alertas-inicio-pie">
                    <span>Puedes volver a abrir este aviso desde "Estado del sistema", arriba a la derecha.</span>
                    <button type="button" class="btn-corporativo" data-bs-dismiss="modal">Entendido</button>
                </div>
            </div>
        </div>
    </div>
}

@helper Barras(System.Collections.Generic.List<EP360_Logistics_Admin.Models.BarraModel> barras, Func<EP360_Logistics_Admin.Models.BarraModel, string> url, string vacio)
{
    if (barras.Count == 0)
    {
        <p class="texto-tenue mb-0">@vacio</p>
    }
    else
    {
        int maximo = Math.Max(1, barras.Max(b => b.Valor));
        <div class="barras-ep">
            @foreach (var b in barras)
            {
                <a class="barra-ep-fila" href="@url(b)" style="color:inherit;">
                    <span class="etiqueta" title="@b.Etiqueta">@b.Etiqueta</span>
                    <span class="barra-ep-pista"><span class="barra-ep-relleno d-block" style="width:@((b.Valor * 100 / maximo).ToString())%;"></span></span>
                    <span class="valor">@b.Valor.ToString("N0")</span>
                </a>
            }
        </div>
    }
}

@section scripts {
    <script>
        // Abre el modal de alertas al entrar, una vez por sesion para el mismo conjunto de alertas.
        (function () {
            var modal = document.getElementById("modalAlertasInicio");
            if (!modal || !window.bootstrap) return;
            var clave = "alertasInicio:" + modal.getAttribute("data-huella");
            var forzar = /[?&]vistaPreviaAlertas=1/.test(location.search);
            try { if (!forzar && sessionStorage.getItem(clave)) return; sessionStorage.setItem(clave, "1"); } catch (e) { }
            bootstrap.Modal.getOrCreateInstance(modal).show();
        })();
    </script>
}
